# ============================================================================
# FILE:       backend-test/.env.example
# PURPOSE:    Safe template for backend configuration. Copy to .env and fill
#             in the real values. Never commit a filled-in .env.
# USED BY / DEPENDS ON: developers setting up the project locally.
# ============================================================================

# --- Application ---
ENVIRONMENT=production
APP_PREFIX=/api/v1
LOG_LEVEL=INFO
DOCS_ENABLED=false

# --- Database (REQUIRED) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://taskflow_user:CHANGE_ME@ep-example-000000.us-east-2.aws.neon.tech/taskflow?sslmode=require
TEST_DATABASE_URL=postgresql+asyncpg://taskflow_user:CHANGE_ME@localhost:5432/taskflow_test
AUTO_MIGRATE=true
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=280
DB_POOL_TIMEOUT=10
DB_SSL=auto
DB_ECHO=false

# --- CORS (REQUIRED) ---
CORS_ORIGINS=https://frontend-five-rust-43.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ALLOW_CREDENTIALS=true

# --- JWT (REQUIRED) ---
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- SMTP / Email OTP (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM=noreply@example.com
OTP_EXPIRE_MINUTES=10

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- AI Assistant providers (optional) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
